# Porta do servidor HTTP
PORT=3000

# Interface de escuta. 127.0.0.1 = só o próprio servidor alcança; é o valor
# certo quando há um proxy reverso com TLS na frente (nginx, Caddy).
#
# NÃO troque para 0.0.0.0 numa VPS com IP público sem firewall na frente: o
# serviço passa a aceitar conexões da internet em HTTP puro, e `GET
# /whatsapp/status` devolve a string do QR — quem a capturar pareia o próprio
# dispositivo na conta de WhatsApp. O WEBHOOK_SECRET também viaja em claro.
HOST=127.0.0.1

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# pretty  → uma linha legível, ideal para `pm2 logs`
# json    → JSON por linha, para agregador (Loki, Datadog...)
LOG_FORMAT=pretty

# Token exigido no header `x-webhook-token` de todas as rotas protegidas.
# Gere um valor forte, ex.: openssl rand -hex 32
WEBHOOK_SECRET=troque-este-valor

# JID do grupo do WhatsApp que vai receber as notificações.
# Deixe vazio no primeiro boot: suba o serviço, pareie o QR e chame
# GET /whatsapp/groups para descobrir o JID, depois preencha aqui e reinicie.
WHATSAPP_GROUP_JID=

# Caminhos de dados (relativos à raiz do projeto)
AUTH_DIR=./data/auth_info
DB_PATH=./data/app.db
