{
  "name": "airbnb-checkin-notifier",
  "version": "1.0.0",
  "description": "Recebe webhook de reserva e notifica check-in em um grupo do WhatsApp",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pm2:start": "npm run build && pm2 start ecosystem.config.cjs",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.cjs --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.cjs",
    "pm2:logs": "pm2 logs checkin-notifier"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luizmuniztravus/airbnb.git"
  },
  "license": "ISC",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "baileys": "^6.7.24",
    "better-sqlite3": "^13.0.3",
    "fastify": "^5.12.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode-terminal": "^0.12.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.4.0",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
